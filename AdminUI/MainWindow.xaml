<Window x:Class="AdminUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AdminUI.Converters"
        Title="Admin Control Panel" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <!-- RESOURCES FOR CONVERTERS -->
    <Window.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="10" Margin="20" Padding="20">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Pending Count -->
                    <RowDefinition Height="*"/>
                    <!-- TabControl -->
                    <RowDefinition Height="200"/>
                    <!-- Logs -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Admin Control Panel" FontSize="24" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Admin: " FontSize="14"/>
                        <TextBox x:Name="AdminNameTextBox" Width="150" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="  |  Status: " FontSize="14" Margin="20,0,0,0"/>
                        <Ellipse x:Name="AdminStatusIndicator" Width="12" Height="12" Fill="Red" Margin="5,0,0,0"/>
                        <TextBlock x:Name="AdminStatusText" Text="Disconnected" FontSize="14" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="AdminIdTextBlock" Text="Admin ID: ..." 
                               FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- PENDING COUNT -->
                <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Pending Requests: " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalPendingTextBlock" Text="0" FontSize="20" 
                                   FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- TAB CONTROL -->
                <TabControl Grid.Row="2" Margin="0,0,0,15">
                    <!-- TAB 1: LOGIN REQUESTS -->
                    <TabItem Header="Login Requests">
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LoginRequestsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding UserName}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock FontSize="12" Foreground="Gray" Margin="0,5,0,0">
                                                            <Run Text="IP:"/>
                                                            <Run Text="{Binding IpAddress}"/>
                                                            <Run Text=" | Device:"/>
                                                            <Run Text="{Binding DeviceInfo}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding RequestedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                                   FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="✓ Approve" Width="90" Height="35" Margin="0,0,10,0"
                                                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                                                Click="ApproveButton_Click" Tag="{Binding}"/>
                                                        <Button Content="✕ Reject" Width="90" Height="35"
                                                                Background="#F44336" Foreground="White" BorderThickness="0"
                                                                Click="RejectButton_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- TAB 2: LOGIN HISTORY -->
                    <TabItem Header="Login History">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- REFRESH BUTTON -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                                <Button x:Name="RefreshHistoryButton" Content="🔄 Refresh History" 
                                        Width="150" Height="35" Background="#2196F3" Foreground="White" 
                                        BorderThickness="0" Click="RefreshHistoryButton_Click"/>
                            </StackPanel>

                            <!-- HISTORY GRID -->
                            <DataGrid Grid.Row="1" x:Name="LoginHistoryDataGrid" 
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" AlternatingRowBackground="#F9F9F9"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      RowHeight="35">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="120"/>
                                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                                    <DataGridTextColumn Header="Device Info" Binding="{Binding DeviceInfo}" Width="*"/>
                                    <DataGridTextColumn Header="Login Time" Binding="{Binding LoginTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                                    <DataGridTemplateColumn Header="Status" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsSuccessful, Converter={StaticResource BoolToStatusConverter}}" 
                                                           Foreground="{Binding IsSuccessful, Converter={StaticResource BoolToColorConverter}}"
                                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- PAGINATION -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button x:Name="PrevPageButton" Content="« Previous" Width="100" Height="30" 
                                        Margin="0,0,10,0" Click="PrevPageButton_Click"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0">
                                    <Run Text="Page "/>
                                    <Run x:Name="CurrentPageTextRun" Text="1"/>
                                    <Run Text=" of "/>
                                    <Run x:Name="TotalPagesTextRun" Text="1"/>
                                </TextBlock>
                                <Button x:Name="NextPageButton" Content="Next »" Width="100" Height="30" 
                                        Margin="10,0,0,0" Click="NextPageButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: USER MANAGEMENT -->
                    <TabItem Header="User Management">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SEARCH AND REFRESH -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                                <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="UserSearchTextBox" Width="200" Height="35" 
                                         VerticalContentAlignment="Center" Margin="0,0,10,0"
                                         TextChanged="UserSearchTextBox_TextChanged"
                                         Tag="Search by username, email, or name..."/>
                                <Button x:Name="RefreshUsersButton" Content="🔄 Refresh Users" 
                                        Width="150" Height="35" Background="#2196F3" Foreground="White" 
                                        BorderThickness="0" Click="RefreshUsersButton_Click"/>
                                <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Run Text="Total Users: "/>
                                    <Run x:Name="TotalUsersTextRun" Text="0" FontWeight="Bold" Foreground="#1976D2"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- USERS GRID -->
                            <DataGrid Grid.Row="1" x:Name="UsersDataGrid" 
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" AlternatingRowBackground="#F9F9F9"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      RowHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="120"/>
                                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                                    <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                                    <DataGridTemplateColumn Header="Status" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" 
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Actions" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="👁️ View" Width="60" Height="28" 
                                                            Background="#2196F3" Foreground="White" BorderThickness="0"
                                                            Click="ViewUserButton_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                                    <Button Content="🔒 Lock" Width="60" Height="28"
                                                            Background="#FF9800" Foreground="White" BorderThickness="0"
                                                            Click="ToggleUserStatusButton_Click" Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="🔒 Lock"/>
                                                                <Setter Property="Background" Value="#FF9800"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Content" Value="🔓 Unlock"/>
                                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- PAGINATION FOR USERS -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button x:Name="UsersPrevPageButton" Content="« Previous" Width="100" Height="30" 
                                        Margin="0,0,10,0" Click="UsersPrevPageButton_Click"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0">
                                    <Run Text="Page "/>
                                    <Run x:Name="UsersCurrentPageTextRun" Text="1"/>
                                    <Run Text=" of "/>
                                    <Run x:Name="UsersTotalPagesTextRun" Text="1"/>
                                </TextBlock>
                                <Button x:Name="UsersNextPageButton" Content="Next »" Width="100" Height="30" 
                                        Margin="10,0,0,0" Click="UsersNextPageButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- LOGS -->
                <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activity Log" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ActivityLogTextBlock"
                                       FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>

</Window>
