<Window x:Class="UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome - Client Portal" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="CanMinimize">
    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667eea" Offset="0"/>
                <GradientStop Color="#764ba2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Container -->
        <Border Background="White" CornerRadius="20" Margin="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <!-- Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60">
                    <!-- Success Icon -->
                    <Ellipse Width="120" Height="120" Fill="#4CAF50" Margin="0,0,0,30">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4CAF50" Opacity="0.4" BlurRadius="20"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="?" FontSize="80" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,-115,0,35" FontWeight="Bold"/>

                    <!-- Welcome Message -->
                    <TextBlock Text="?? Welcome!" FontSize="42" FontWeight="Bold" 
                               Foreground="#333" TextAlignment="Center" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Login Approved Successfully" FontSize="20" 
                               Foreground="#666" TextAlignment="Center" Margin="0,0,0,40"/>

                    <!-- User Info Card -->
                    <Border Background="#F8F9FA" CornerRadius="15" Padding="30" 
                            BorderBrush="#E0E0E0" BorderThickness="2" Margin="0,0,0,30"
                            MinWidth="400">
                        <StackPanel>
                            <!-- Username -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="??" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Username" FontSize="12" Foreground="#999"/>
                                    <TextBlock x:Name="UsernameTextBlock" Text="user123" 
                                               FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Approved By -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="??" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Approved By" FontSize="12" Foreground="#999"/>
                                    <TextBlock x:Name="ApprovedByTextBlock" Text="Admin" 
                                               FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Approved Time -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="??" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Approved At" FontSize="12" Foreground="#999"/>
                                    <TextBlock x:Name="ApprovedTimeTextBlock" Text="2024-01-01 12:00:00" 
                                               FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Success Message -->
                    <Border Background="#E8F5E9" CornerRadius="10" Padding="20" 
                            BorderBrush="#4CAF50" BorderThickness="2" Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="? Your login request has been approved!" 
                                       FontSize="16" Foreground="#2E7D32" 
                                       TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="You now have access to the system." 
                                       FontSize="14" Foreground="#43A047" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ContinueButton" Content="Continue to Dashboard" 
                                Width="200" Height="50" FontSize="16" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Margin="0,0,15,0" Click="ContinueButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="10" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45A049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="LogoutButton" Content="Logout" 
                                Width="120" Height="50" FontSize="16" FontWeight="Bold"
                                Background="#666" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="LogoutButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="10" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#555"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Close Button -->
                <Button Content="?" Width="35" Height="35" 
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,15,15,0" Background="Transparent" 
                        BorderThickness="0" Foreground="#999" 
                        FontSize="20" FontWeight="Bold" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
