<Window x:Class="UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome - Client Portal" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="CanResize">
    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667eea" Offset="0"/>
                <GradientStop Color="#764ba2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Container -->
        <Border Background="White" CornerRadius="20" Margin="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,30">
                    <!-- Success Icon -->
                    <Ellipse Width="100" Height="100" Fill="#4CAF50" HorizontalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4CAF50" Opacity="0.4" BlurRadius="20"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="?" FontSize="70" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,-90,0,20" FontWeight="Bold"/>

                    <!-- Welcome Message -->
                    <TextBlock Text="?? Welcome!" FontSize="38" FontWeight="Bold" 
                               Foreground="#333" TextAlignment="Center" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Login Approved Successfully" FontSize="18" 
                               Foreground="#666" TextAlignment="Center"/>
                </StackPanel>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- User Profile Card -->
                        <Border Background="#F8F9FA" CornerRadius="15" Padding="30" 
                                BorderBrush="#E0E0E0" BorderThickness="2" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="120" Height="120" 
                                        Background="#667eea" CornerRadius="60" 
                                        VerticalAlignment="Top" Margin="0,0,30,0">
                                    <TextBlock Text="??" FontSize="60" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="USER INFORMATION" FontSize="14" 
                                               FontWeight="Bold" Foreground="#999" Margin="0,0,0,15"/>

                                    <!-- Username -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Username" FontSize="11" Foreground="#999"/>
                                            <TextBlock x:Name="UsernameTextBlock" Text="user123" 
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Full Name -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Full Name" FontSize="11" Foreground="#999"/>
                                            <TextBlock x:Name="FullNameTextBlock" Text="John Doe" 
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Email -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Email" FontSize="11" Foreground="#999"/>
                                            <TextBlock x:Name="EmailTextBlock" Text="user@example.com" 
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Phone -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Phone Number" FontSize="11" Foreground="#999"/>
                                            <TextBlock x:Name="PhoneTextBlock" Text="+84 123 456 789" 
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Approval Info Card -->
                        <Border Background="#E8F5E9" CornerRadius="15" Padding="25" 
                                BorderBrush="#4CAF50" BorderThickness="2" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="APPROVAL DETAILS" FontSize="14" 
                                           FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,15"/>

                                <!-- Approved By -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Approved By" FontSize="11" Foreground="#388E3C"/>
                                        <TextBlock x:Name="ApprovedByTextBlock" Text="Admin" 
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Approved Time -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="??" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Approved At" FontSize="11" Foreground="#388E3C"/>
                                        <TextBlock x:Name="ApprovedTimeTextBlock" Text="2024-01-01 12:00:00" 
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Success Message -->
                        <Border Background="#E3F2FD" CornerRadius="10" Padding="20" 
                                BorderBrush="#2196F3" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="? Your login request has been approved!" 
                                           FontSize="16" Foreground="#1565C0" 
                                           TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="You now have full access to the system. Click 'Continue' to proceed to your dashboard." 
                                           FontSize="13" Foreground="#1976D2" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="ContinueButton" Content="Continue to Dashboard" 
                            Width="220" Height="50" FontSize="16" FontWeight="Bold"
                            Background="#4CAF50" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Margin="0,0,15,0" Click="ContinueButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="LogoutButton" Content="Logout" 
                            Width="120" Height="50" FontSize="16" FontWeight="Bold"
                            Background="#666" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="LogoutButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#555"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Top Right Close Button -->
                <Button Content="?" Width="35" Height="35" 
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Grid.Row="0" Margin="0,-10,-10,0" Background="Transparent" 
                        BorderThickness="0" Foreground="#999" 
                        FontSize="20" FontWeight="Bold" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
